
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..oMKmMoZJKn1QjLPh0QXcJ4m2bicj9NWD_HkBbeIueMY
@marekToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..0xelRhBVBMB8Eom0mOQLqsQs8eYe1eQcgvjaq7EyNqY

### 1) CREATE room 101 in building 1
# @name roomB1
POST {{baseUrl}}/api/admin/room/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: 1

{ "RoomNumber": 102, "FloorNumber": 1, "Capacity": 2 }

### 2) CREATE room 101 in building 2 (same number, different building)
# @name roomB2
POST {{baseUrl}}/api/admin/room/create
Content-Type: application/json
Authorization: Bearer {{marekToken}}
X-Building-Id: 1

{ "RoomNumber": 103, "FloorNumber": 1, "Capacity": 4 }

### 3) LIST building 1 (expect only the capacity-2 room)
GET {{baseUrl}}/api/admin/room/get-all
Authorization: Bearer {{marekToken}}
X-Building-Id: 1

### 4) LIST building 2 (expect only the capacity-4 room)
GET {{baseUrl}}/api/admin/room/get-all
Authorization: Bearer {{marekToken}}
X-Building-Id: 2

### 5) LIST building 3 (expect an empty list)
GET {{baseUrl}}/api/admin/room/get-all
Authorization: Bearer {{managerToken}}
X-Building-Id: 3

### 6) NO header (expect 400)
GET {{baseUrl}}/api/admin/room/get-all
Authorization: Bearer {{managerToken}}

### 7) Building you don't belong to (expect 403)
GET {{baseUrl}}/api/admin/room/get-all
Authorization: Bearer {{managerToken}}
X-Building-Id: 99

### 8) Cross-building access: update the building 2 room using header 1 (expect 404)
PUT {{baseUrl}}/api/admin/room/update/{{roomB2.payload.id}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}
X-Building-Id: 1

{ "Capacity": 3 }

### 9) Same update with the correct header (expect 200)
PUT {{baseUrl}}/api/admin/room/update/{{roomB2.payload.id}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}
X-Building-Id: 2

{ "Capacity": 3 }