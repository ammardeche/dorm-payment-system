# SEED: 5 managers (one per building) + 1 receptionist created by each manager.
# Run ONCE on a fresh database, top to bottom ("Send all" or one by one).
# Needs: setup/01-login-admin.http first (it saves {{adminToken}}). Building ids 1 to 5 are seeded.
#
# Accounts created (all passwords: Manager@123 for managers, Recept@123 for receptionists)
#   manager1@dorm.local -> building 1      reception1@dorm.local (created BY manager1)
#   manager2@dorm.local -> building 2      reception2@dorm.local
#   manager3@dorm.local -> building 3      reception3@dorm.local
#   manager4@dorm.local -> building 4      reception4@dorm.local
#   manager5@dorm.local -> building 5      reception5@dorm.local
# Running it twice gives 409 (email already registered). Drop the database to start again.

################################################################
# MANAGER 1  ->  building 1
################################################################

@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..oMKmMoZJKn1QjLPh0QXcJ4m2bicj9NWD_HkBbeIueMY
@piotrToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lsvWnVMNtRyHTBD6ggxdeXgjzTJ39gaLSdJ7Aw4j0g8
### 1.1) Admin creates manager 1           # EXPECT 200
POST {{baseUrl}}/api/auth/register-staff
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "firstName": "Piotr", "lastName": "Kowalski", "email": "manager1@dorm.local", "password": "Manager@123", "role": "Manager" }

### 1.2) Manager 1 logs in -> saves mgr1Token and mgr1Id
# @name loginManager1
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "manager1@dorm.local", "password": "Manager@123" }

{{
  const t = response.parsedBody.payload.token;
  exports.mgr1Token = t;
  const claims = JSON.parse(Buffer.from(t.split('.')[1], 'base64url').toString());
  exports.mgr1Id = claims['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier'];
}}

### 1.3) Admin gives building 1 to manager 1   # EXPECT 200
POST {{baseUrl}}/api/admin/user/3c11d121-7607-49d4-91a6-0d5e5e89c939/buildings/1
Authorization: Bearer {{adminToken}}

### 1.4) Manager 1 creates a receptionist in building 1   # EXPECT 200
POST {{baseUrl}}/api/auth/register-receptionist
Content-Type: application/json
Authorization: Bearer {{piotrToken}}

{ "firstName": "Reception1", "lastName": "Test", "email": "reception1@dorm.local", "password": "Recept@123", "buildingId": 1 }

