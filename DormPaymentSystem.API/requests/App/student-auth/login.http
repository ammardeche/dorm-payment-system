{ "GuestFullName": "Guest One", "GuestNationalId": "11111111111" }

### 3) Anna again, the same month
# EXPECT 409 "already used their invitation this month"
POST {{baseUrl}}/api/app/myinvitation/create
Content-Type: application/json
Authorization: Bearer {{annaToken}}

{ "GuestFullName": "Guest Two", "GuestNationalId": "22222222222" }

