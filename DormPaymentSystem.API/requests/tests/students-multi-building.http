@buildingA = 1
@buildingB = 2

{{
  // unique suffix, so you can run the whole file again without duplicate numbers
  exports.suffix = String(Date.now()).slice(-6);
}}

### 1) CREATE student in building A
# EXPECT 200: isActive true, room null, payments []
# @name s1
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{
  "firstName": "Anna",
  "lastName": "Kowalska",
  "email": "s9{{suffix}}1@student.tu.kielce.pl",
  "studentNumber": "s9{{suffix}}1",
  "phoneNumber": "600100101",
  "password": "Pass123!"
}

### 2) CREATE student in building B
# EXPECT 200: a different id
# @name s2
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingB}}

{
  "firstName": "Piotr",
  "lastName": "Nowak",
  "email": "s9{{suffix}}2@student.tu.kielce.pl",
  "studentNumber": "s9{{suffix}}2",
  "phoneNumber": "600100102",
  "password": "Pass123!"
}

### 3) CREATE without the building header
# EXPECT 400: "Send one valid X-Building-Id header"
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "firstName": "X", "lastName": "X", "email": "x@x.pl", "studentNumber": "s9{{suffix}}9", "password": "Pass123!" }

### 4) CREATE in a building you don't belong to
# EXPECT 403
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: 99

{ "firstName": "X", "lastName": "X", "email": "x@x.pl", "studentNumber": "s9{{suffix}}9", "password": "Pass123!" }

### 5) CREATE with a duplicate student number (the number of student 1, in building B)
# EXPECT 409: "Account for student number ... already exists" (numbers are unique across ALL buildings)
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingB}}

{ "firstName": "Dup", "lastName": "Dup", "email": "dup@x.pl", "studentNumber": "s9{{suffix}}1", "password": "Pass123!" }

### 6) CREATE with a missing required field
# EXPECT 400: "Fill all required fields."
POST {{baseUrl}}/api/admin/student/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "lastName": "NoFirstName", "email": "n@x.pl", "studentNumber": "s9{{suffix}}8", "password": "Pass123!" }

### 7) LIST building A
# EXPECT 200: only Anna (totalCount 1 on a clean database)
GET {{baseUrl}}/api/admin/student/get-all
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 8) LIST building B
# EXPECT 200: only Piotr
GET {{baseUrl}}/api/admin/student/get-all
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingB}}

### 9) STATS building A
# EXPECT 200: total 1, active 1, inactive 0, newThisMonth 1
GET {{baseUrl}}/api/admin/student/stats
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 10) GET student 1 with the correct building
# EXPECT 200
GET {{baseUrl}}/api/admin/student/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 11) GET student 1 with the WRONG building
# EXPECT 404: the student exists, but not in building B (the important isolation test)
GET {{baseUrl}}/api/admin/student/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingB}}

### 12) UPDATE student 1 (correct building)
# EXPECT 200: firstName becomes "Anna Maria"
PUT {{baseUrl}}/api/admin/student/update/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "firstName": "Anna Maria" }

### 13) UPDATE student 1 from the wrong building
# EXPECT 404
PUT {{baseUrl}}/api/admin/student/update/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingB}}

{ "firstName": "Hacked" }

### 14) DELETE while still active
# EXPECT 400: "Student must be deactivated before deleting."
DELETE {{baseUrl}}/api/admin/student/delete/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 15) DEACTIVATE student 1 (no payments, so they can leave)
# EXPECT 200: success
POST {{baseUrl}}/api/admin/student/deactivate/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "DepartureNote": "Moved out" }

### 16) DEACTIVATE again
# EXPECT 400: "Student is already deactivated."
POST {{baseUrl}}/api/admin/student/deactivate/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "DepartureNote": "again" }

### 17) UPDATE a deactivated student
# EXPECT 400: "Cannot update a deactivated student."
PUT {{baseUrl}}/api/admin/student/update/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "firstName": "Nope" }

### 18) REACTIVATE
# EXPECT 200: isActive true again, room still null
POST {{baseUrl}}/api/admin/student/reactivate/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 19) REACTIVATE an active student
# EXPECT 400: "Student is already active."
POST {{baseUrl}}/api/admin/student/reactivate/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

### 20) DEACTIVATE, then DELETE (run 20a, then 20b)
# 20a EXPECT 200
POST {{baseUrl}}/api/admin/student/deactivate/{{s1.payload.id}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}

{ "DepartureNote": "cleanup" }

### 20b EXPECT 200: the student is deleted
DELETE {{baseUrl}}/api/admin/student/delete/{{s1.payload.id}}
Authorization: Bearer {{adminToken}}
X-Building-Id: {{buildingA}}